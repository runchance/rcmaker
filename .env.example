; 最小默认配置：内置 Medoo + SQLite、文件缓存、文件 Session。
; 无需另装数据库、缓存服务或可选 Composer 组件；框架基础依赖仍需安装。
; PHP 需启用 pdo_sqlite；其他配置按需参考 config/ 与官方文档添加。

[app]
debug = false
start_app = true
cli_frame = workerman
cli_log = false
default_timezone = Asia/Shanghai
memory_limit = 256M
count = false
route = true
with_custom_route = false

[bootstrap]
; 由框架初始化，业务代码不需要自行调用 start()。
load[] = RC\Session
load[] = RC\Helper\Cache\Raw
load[] = RC\Helper\Db\Medoo

[db]
default_frame = medoo
default = sqlite
; 默认文件：程序外部 data/database/rcmaker.sqlite，目录自动创建。
; 已有 RCMAKER.db 或显式 sqlite.database 配置继续保留，不自动迁移。

[workerman]
; 本机开发默认不对外暴露；部署时可改为 http://0.0.0.0:8680。
listen = 'http://127.0.0.1:8680'
count = 1
; 仅 Windows 使用，旧环境未设置时同样默认 1，不影响 Linux count。
windows_count = 1
max_request = 1000000
